# Copier ce fichier en « .env » et compléter. Ne jamais committer le fichier .env.

# --- IA (Mistral) ---
MISTRAL_API_KEY=
MISTRAL_MODELE=mistral-small-latest
# Serveur Mistral : « eu » (api.eu.mistral.ai, recommandé) ou « global »
MISTRAL_SERVEUR=eu
# Tarifs en dollars par million de jetons, pour l'estimation --dry-run (à vérifier sur mistral.ai)
MISTRAL_PRIX_ENTREE_PAR_M=0.1
MISTRAL_PRIX_SORTIE_PAR_M=0.3

# --- Référentiels ---
CHEMIN_BASE_ASN=scanner/src/bleublanccloud/referentiels/telechargements/asn.mmdb
# Jeton gratuit IPinfo (https://ipinfo.io/signup) pour télécharger la base IPinfo Lite (.mmdb)
IPINFO_TOKEN=

# --- Stockage ---
CHEMIN_BASE_SQLITE=donnees/bleublanccloud.db

# --- Politesse du scanner ---
CONCURRENCE_MAX=20
DELAI_EXPIRATION_S=10
USER_AGENT="BleuBlancCloudBot/1.0 (+https://bleublanccloud.berachem.dev/methodologie)"

# --- Publication ---
# URL git (SSH) du dépôt Codeberg Pages, ex. git@codeberg.org:berachem/bleublanccloud-pages.git
DEPOT_PAGES=
# Branche publiée et domaine personnalisé (valeurs par défaut ci-dessous)
BRANCHE_PAGES=pages
DOMAINE_SITE=bleublanccloud.berachem.dev

# --- Analyses sur demande (tickets « Analyser mon site » sur Codeberg) ---
# Jeton Codeberg aux droits minimaux : Paramètres → Applications → Générer un jeton,
# accès « Dépôts spécifiques » limité au dépôt ci-dessous, permission « issue : lecture et
# écriture » uniquement. Laisser vide pour désactiver. Ne jamais le committer ni le journaliser.
CODEBERG_JETON=
DEPOT_DEMANDES=berachem/bleublanccloud-pages
CODEBERG_API=https://codeberg.org/api/v1
# Limites : demandes acceptées par jour au total, et par jour et par compte Codeberg
DEMANDES_LIMITE_JOUR=10
DEMANDES_LIMITE_COMPTE=1
