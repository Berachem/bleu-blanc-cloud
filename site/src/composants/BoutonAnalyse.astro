---
// Bouton « Analyser mon site » : ouvre la fenêtre de choix (ticket Codeberg ou e-mail).
// Sans JavaScript, le lien mène directement au formulaire Codeberg.
import { URL_DEMANDE_FORMULAIRE } from "../lib/demandes";
interface Props {
  secondaire?: boolean;
}
const { secondaire = false } = Astro.props;
---
<div class="demande-analyse">
  <a
    class:list={["bouton", secondaire && "bouton--secondaire"]}
    href={URL_DEMANDE_FORMULAIRE}
    data-ouvrir-analyse
    aria-haspopup="dialog"
  >
    Analyser mon site
  </a>
</div>
