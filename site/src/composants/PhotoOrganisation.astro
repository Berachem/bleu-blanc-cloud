---
// Photo de l'organisation : fichier Wikimedia Commons téléchargé par le serveur et servi par
// le site lui-même (aucune requête externe), avec auteur et licence. À défaut, illustration.
import EtoilesEurope from "./EtoilesEurope.astro";
import type { OrganisationExport } from "../lib/types";
interface Props {
  organisation: OrganisationExport;
}
const { organisation } = Astro.props;
const photo = organisation.photo;
const depuisCommons = photo ? new URL(photo.url_source).hostname === "commons.wikimedia.org" : false;
---
<figure class="photo-organisation">
  <div class="photo-organisation__cadre">
    {
      photo ? (
        <img
          src={photo.url}
          width={photo.largeur || 1280}
          height={photo.hauteur || 960}
          alt={`Photographie illustrant ${organisation.nom} (Wikimedia Commons)`}
          fetchpriority="high"
          decoding="async"
        />
      ) : (
        <div class="illustration-organisation" aria-hidden="true">
          <EtoilesEurope />
          <strong>{organisation.nom}</strong>
        </div>
      )
    }
  </div>
  {
    photo && (
      <figcaption>
        Photo : {photo.auteur} —{" "}
        {photo.url_licence ? <a href={photo.url_licence}>{photo.licence}</a> : photo.licence} —{" "}
        <a href={photo.url_source}>{depuisCommons ? "source Wikimedia Commons" : "source"}</a>
      </figcaption>
    )
  }
</figure>
