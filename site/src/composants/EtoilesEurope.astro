---
// Motif décoratif : 12 étoiles jaunes disposées en cercle, qui tournent lentement.
// Volontairement sans fond bleu : ce n'est pas le drapeau européen et il n'implique
// aucune approbation officielle. Rotation désactivée avec prefers-reduced-motion.
// « rayonEtoile » : taille des étoiles (unités du dessin de 200 × 200, cercle de rayon 70).
interface Props {
  rayonEtoile?: number;
}
const { rayonEtoile = 11 } = Astro.props;
const etoiles = Array.from({ length: 12 }, (_, i) => {
  const angle = (i * Math.PI) / 6 - Math.PI / 2;
  return { x: 100 + 70 * Math.cos(angle), y: 100 + 70 * Math.sin(angle) };
});
const branche = (cx: number, cy: number, r: number) =>
  Array.from({ length: 10 }, (_, k) => {
    const rayon = k % 2 === 0 ? r : r * 0.4;
    const a = (k * Math.PI) / 5 - Math.PI / 2;
    return `${(cx + rayon * Math.cos(a)).toFixed(1)},${(cy + rayon * Math.sin(a)).toFixed(1)}`;
  }).join(" ");
---
<div class="etoiles" aria-hidden="true">
  <svg class="etoiles__cercle" viewBox="0 0 200 200" focusable="false">
    {etoiles.map((e) => <polygon points={branche(e.x, e.y, rayonEtoile)} fill="#FFCC00" />)}
  </svg>
</div>
