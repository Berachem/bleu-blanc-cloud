---
// Recherche instantanée : l'index léger (/recherche.json) n'est chargé qu'à la première saisie.
// C'est aussi un formulaire : Entrée (ou « Rechercher ») ouvre les classements filtrés,
// y compris sans JavaScript.
// Variantes : « accroche » (page d'accueil : champ en pilule et bouton, sans libellé visible)
// et « entete » (panneau ouvert par la loupe de l'en-tête).
import { URL_DEMANDE_FORMULAIRE } from "../lib/demandes";
interface Props {
  identifiant?: string;
  variante?: "standard" | "accroche" | "entete";
}
const { identifiant = "recherche", variante = "standard" } = Astro.props;
const avecAide = variante !== "accroche";
---
<form
  class:list={["recherche", `recherche--${variante}`]}
  role="search"
  action="/classements/"
  method="get"
  data-recherche
  data-url-demande={URL_DEMANDE_FORMULAIRE}
>
  <div class="champ">
    <label for={identifiant} class:list={[variante === "accroche" && "visuellement-cache"]}>
      Rechercher une organisation
    </label>
    <div class="recherche__saisie">
      <input
        id={identifiant}
        name="texte"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="Commune, département, domaine…"
        aria-describedby={avecAide ? `${identifiant}-aide` : undefined}
        aria-controls={`${identifiant}-resultats`}
      />
      <button class="recherche__bouton" type="submit">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.6-3.6"></path></svg>
        <span>Rechercher</span>
      </button>
    </div>
    {
      avecAide && (
        <span id={`${identifiant}-aide`} class="texte-secondaire petit">
          Ou consultez <a href="/classements/">la liste complète</a>.
        </span>
      )
    }
  </div>
  <ul id={`${identifiant}-resultats`} class="recherche__resultats" aria-live="polite"></ul>
</form>

<script>
  type Ligne = [
    slug: string,
    nom: string,
    departement: string,
    note: string,
    score: number,
    domaine: string,
    provisoire: 0 | 1,
  ];
  const normaliser = (texte: string) =>
    texte.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();

  // Relancé après chaque transition de page (View Transitions)
  document.addEventListener("astro:page-load", () => {
  for (const bloc of document.querySelectorAll<HTMLFormElement>("[data-recherche]")) {
    const champ = bloc.querySelector("input");
    const liste = bloc.querySelector("ul");
    if (!champ || !liste) continue;
    let donnees: Promise<Ligne[]> | null = null;
    const charger = () =>
      (donnees ??= fetch("/recherche.json").then((reponse) => reponse.json() as Promise<Ligne[]>));

    champ.addEventListener("focus", () => void charger(), { once: true });
    // Numéro de la dernière saisie : une recherche terminée après une saisie plus récente
    // (ex. champ vidé pendant le chargement de l'index) est ignorée.
    let derniere = 0;
    champ.addEventListener("input", async () => {
      const numero = ++derniere;
      const requete = normaliser(champ.value.trim());
      liste.replaceChildren();
      if (requete.length < 2) return;
      const lignes = await charger();
      if (numero !== derniere) return;
      const trouvees = lignes
        .filter(([, nom, departement, , , domaine]) =>
          normaliser(`${nom} ${departement} ${domaine}`).includes(requete),
        )
        .slice(0, 8);
      if (trouvees.length === 0) {
        const vide = document.createElement("li");
        vide.className = "texte-secondaire petit";
        vide.style.padding = "0.8rem 1rem";
        vide.textContent = "Aucune organisation trouvée. ";
        const demande = document.createElement("a");
        demande.href = bloc.dataset.urlDemande ?? "/methodologie/";
        demande.dataset.ouvrirAnalyse = "";
        demande.setAttribute("aria-haspopup", "dialog");
        demande.textContent = "Faire analyser un site";
        vide.append(demande);
        liste.append(vide);
        return;
      }
      for (const [slug, nom, departement, note, score, , provisoire] of trouvees) {
        const element = document.createElement("li");
        const lien = document.createElement("a");
        lien.href = `/organisation/${slug}/`;
        const badge = document.createElement("span");
        badge.className = `badge note-${note}${provisoire ? " badge--provisoire" : ""}`;
        badge.textContent = note;
        badge.setAttribute("aria-hidden", "true");
        const texte = document.createElement("span");
        texte.textContent = `${nom}${departement ? ` · ${departement}` : ""} — ${score}/100 (note ${note}${provisoire ? " provisoire" : ""})`;
        lien.append(badge, texte);
        element.append(lien);
        liste.append(element);
      }
    });
    champ.addEventListener("keydown", (evenement) => {
      if (evenement.key === "Escape") {
        champ.value = "";
        liste.replaceChildren();
      }
    });
    // Entrée ou « Rechercher » : classements filtrés, seulement à partir de 2 caractères
    bloc.addEventListener("submit", (evenement) => {
      if (champ.value.trim().length < 2) {
        evenement.preventDefault();
        champ.focus();
      }
    });
  }
  });
</script>
