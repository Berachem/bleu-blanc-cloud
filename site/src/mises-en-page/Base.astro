---
import { ClientRouter } from "astro:transitions";
import "../styles/theme.css";
import FenetreAnalyse from "../composants/FenetreAnalyse.astro";
import Logo from "../composants/Logo.astro";
import { NAVIGATION, SITE } from "../config";
import { meta } from "../lib/donnees";
import { date } from "../lib/format";
import { DATE_BUILD, IMAGE_PARTAGE, VERSION_SITE } from "../lib/version";

interface Props {
  titre: string;
  description?: string;
}
const { titre, description = SITE.description } = Astro.props;
const titreComplet = titre === SITE.nom ? `${SITE.nom} — souveraineté numérique des services publics` : `${titre} — ${SITE.nom}`;
const canonique = new URL(Astro.url.pathname, SITE.url).href;
const cheminCourant = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const demonstration = meta().donnees_demonstration;
const imagePartage = new URL(`${IMAGE_PARTAGE.chemin}?v=${IMAGE_PARTAGE.empreinte}`, SITE.url).href;
---
<!doctype html>
<html lang="fr" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="preload" href="/polices/Luciole-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/polices/Luciole-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0a0f24" />
    <meta name="color-scheme" content="dark light" />
    <meta name="referrer" content="no-referrer" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={SITE.nom} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <!-- Aperçu lors d'un partage (réseaux sociaux, messageries) : image 1200 × 630 servie par
         le site lui-même (scripts/generer-image-partage.mjs) -->
    <meta property="og:image" content={imagePartage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(IMAGE_PARTAGE.largeur)} />
    <meta property="og:image:height" content={String(IMAGE_PARTAGE.hauteur)} />
    <meta property="og:image:alt" content={IMAGE_PARTAGE.texte} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titreComplet} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagePartage} />
    <meta name="twitter:image:alt" content={IMAGE_PARTAGE.texte} />
    <meta name="generator" content={Astro.generator} />
    <!-- Thème mémorisé et animations appliqués avant l'affichage (aucun flash), y compris
         après chaque transition de page. Sombre par défaut. -->
    <script is:inline>
      (() => {
        const appliquer = () => {
          let theme = "dark";
          try {
            theme = localStorage.getItem("bbc-theme") === "light" ? "light" : "dark";
          } catch {}
          const racine = document.documentElement;
          racine.dataset.theme = theme;
          // Sans JavaScript, le menu mobile reste déplié (aucun lien caché)
          racine.classList.add("js");
          if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
            racine.classList.add("js-animations");
          }
        };
        appliquer();
        document.addEventListener("astro:after-swap", appliquer);
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="evitement" href="#contenu">Aller au contenu</a>
    <div class="bandeau-tricolore" aria-hidden="true"></div>
    {
      demonstration && (
        <p class="bandeau-demo">
          Données de démonstration fictives : aucune organisation réelle n'est présentée.
        </p>
      )
    }
    <header class="entete">
      <div class="conteneur">
        <a class="logo" href="/" aria-label={`${SITE.nom} — accueil`} transition:name="logo">
          <Logo />
        </a>
        <button
          class="bouton-menu"
          type="button"
          data-bouton-menu
          aria-expanded="false"
          aria-controls="navigation-principale"
          aria-label="Ouvrir le menu"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true" focusable="false"><path class="menu-trait-1" d="M4 7h16"></path><path class="menu-trait-2" d="M4 12h16"></path><path class="menu-trait-3" d="M4 17h16"></path></svg>
        </button>
        <nav class="navigation" id="navigation-principale" aria-label="Navigation principale">
          <ul>
            {
              NAVIGATION.map((entree) => (
                <li>
                  <a
                    href={entree.href}
                    aria-current={cheminCourant === entree.href ? "page" : undefined}
                  >
                    {entree.libelle}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <button class="bascule-theme" type="button" data-bascule-theme aria-pressed="false" aria-label="Passer en thème clair">
          <svg class="icone-soleil" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          <svg class="icone-lune" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
        </button>
      </div>
    </header>
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <FenetreAnalyse />
    <footer class="pied">
      <div class="conteneur">
        <div>
          <p>
            <strong>{SITE.nom}</strong> est un projet personnel, indépendant et open source.
            Il n'a <strong>aucun lien avec l'État ni avec l'Union européenne</strong>.
          </p>
          <p>
            Le score ne reflète que l'empreinte externe et visible publiquement des organisations,
            pas leurs outils internes. Il est indicatif.
          </p>
        </div>
        <div>
          <h2>Comprendre</h2>
          <ul>
            <li><a href="/methodologie/">Méthodologie</a></li>
            <li><a href="/alternatives/">Alternatives européennes</a></li>
            <li><a href="/a-propos/">À propos</a></li>
          </ul>
        </div>
        <div>
          <h2>Le projet</h2>
          <ul>
            <li><a href="/retrait/">Retrait et droit de réponse</a></li>
            <li><a href="/mentions-legales/">Mentions légales</a></li>
            <li><a href={SITE.depot}>Code source ({SITE.licenceCode})</a></li>
          </ul>
        </div>
      </div>
      <p class="conteneur pied__version">
        Version du site <a href={`${SITE.depot}/commit/${VERSION_SITE}`}><code>{VERSION_SITE}</code></a>,
        construite le {date(DATE_BUILD.toISOString())}
      </p>
    </footer>
    <script>
      import "../lib/animations";
    </script>
  </body>
</html>
