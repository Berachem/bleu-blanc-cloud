---
// Contenu publié directement depuis docs/methodologie.md (source unique, versionnée).
import BoutonAnalyse from "../composants/BoutonAnalyse.astro";
import Base from "../mises-en-page/Base.astro";
import { date } from "../lib/format";
import { annoterTableaux } from "../lib/libelles-tableaux";
import { compiledContent, frontmatter } from "../../../docs/methodologie.md";

// Tableaux lisibles sur mobile : libellé de colonne recopié sur chaque cellule
const contenu = annoterTableaux(await compiledContent());
---
<Base
  titre="Méthodologie"
  description="Comment Bleu Blanc Cloud calcule le score de dépendance numérique : sondes passives, niveaux de juridiction, pondération, limites."
>
  <div class="conteneur prose">
    <p class="surtitre" style="margin-top: 2rem">
      Version {frontmatter.version} du {date(new Date(frontmatter.date).toISOString())}
    </p>
    <Fragment set:html={contenu} />
    <section class="section" aria-labelledby="titre-demande">
      <h2 id="titre-demande">Faire analyser un site</h2>
      <p>
        Un site absent de l'observatoire&nbsp;? Demandez son analyse (règles détaillées dans la
        section « Analyses sur demande » ci-dessus).
      </p>
      <BoutonAnalyse />
    </section>
  </div>
</Base>
