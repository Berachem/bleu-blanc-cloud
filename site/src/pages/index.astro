---
import BadgeNote from "../composants/BadgeNote.astro";
import BoutonAnalyse from "../composants/BoutonAnalyse.astro";
import CarteFrance from "../composants/CarteFrance.astro";
import CarteOrganisation from "../composants/CarteOrganisation.astro";
import EtoilesEurope from "../composants/EtoilesEurope.astro";
import Recherche from "../composants/Recherche.astro";
import Base from "../mises-en-page/Base.astro";
import { departements, meta, observatoire, organisations } from "../lib/donnees";
import { date, nombre } from "../lib/format";

// Statistiques et derniers scans : observatoire seulement (hors analyses sur demande)
const entrees = observatoire();
const toutes = organisations();
const total = entrees.length;
const moyenne = total ? entrees.reduce((somme, e) => somme + e.score, 0) / total : 0;
const scoreCategorie = (slug: string, categorie: string) =>
  toutes.find((o) => o.slug === slug)?.score.detail.find((d) => d.categorie === categorie);
const part = (valeur: number) => (total ? Math.round((100 * valeur) / total) : 0);
const messagerieD = part(entrees.filter((e) => scoreCategorie(e.slug, "messagerie")?.score === 0).length);
const audienceD = part(entrees.filter((e) => scoreCategorie(e.slug, "mesure_audience")?.score === 0).length);
const europeens = part(entrees.filter((e) => e.note === "A").length);
const recents = [...entrees].sort((a, b) => b.date_scan.localeCompare(a.date_scan)).slice(0, 6);
const repartition = ["A", "B", "C", "D", "E"].map((note) => ({
  note,
  nombre: entrees.filter((e) => e.note === note).length,
}));
const infos = meta();
const chiffres = [
  { valeur: total, suffixe: "", libelle: "organisations analysées", alerte: false },
  { valeur: Math.round(moyenne), suffixe: "/100", libelle: "score moyen", alerte: false },
  { valeur: messagerieD, suffixe: " %", libelle: "ont une messagerie soumise au Cloud Act", alerte: true },
  { valeur: audienceD, suffixe: " %", libelle: "utilisent une mesure d'audience extra-européenne", alerte: true },
];
---
<Base titre="Bleu Blanc Cloud">
  <section class="accroche" aria-labelledby="titre-accueil">
    <EtoilesEurope />
    <div class="conteneur">
      <div class="accroche__texte">
        <span class="surtitre">Observatoire indépendant · open source</span>
        <h1 id="titre-accueil">
          Nos services publics dépendent-ils du <span class="degrade">cloud américain</span>&nbsp;?
        </h1>
        <p class="accroche__intro">
          Bleu Blanc Cloud mesure, de façon passive et transparente, où vivent les sites, la
          messagerie et les services numériques des collectivités françaises, et propose des pistes
          vers des alternatives françaises et européennes.
        </p>
        <Recherche />
        <BoutonAnalyse secondaire />
        <p class="accroche__meta">
          Campagne du {date(infos.date_campagne)} ·
          <a href="/methodologie/">méthodologie v{infos.version_methodo}</a>
        </p>
      </div>
    </div>
  </section>

  <div class="conteneur bande-chiffres">
    <h2 class="visuellement-cache">Chiffres clés</h2>
    <ul class="chiffres">
      {
        chiffres.map((chiffre) => (
          <li class:list={["chiffre", "apparition", chiffre.alerte && "chiffre--alerte"]}>
            <span class="chiffre__valeur" data-compteur={chiffre.valeur} data-suffixe={chiffre.suffixe}>
              {nombre(chiffre.valeur)}{chiffre.suffixe}
            </span>
            <span class="chiffre__libelle">{chiffre.libelle}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="conteneur">
    <section class="section bloc-carte" aria-labelledby="titre-carte">
      <div>
        <h2 id="titre-carte" class="apparition">La France, département par département</h2>
        <p class="chapeau apparition">
          Couleur : note moyenne des organisations analysées. Sélectionnez un département pour voir
          ses organisations, ou consultez <a href="/carte/">la carte détaillée et son tableau</a>.
        </p>
        <ul class="repartition apparition" aria-label="Répartition des notes">
          {
            repartition.map((r) => (
              <li>
                <BadgeNote note={r.note} />
                <b data-compteur={r.nombre}>{r.nombre}</b>
                <span class="visuellement-cache">organisation(s)</span>
              </li>
            ))
          }
        </ul>
        <p class="texte-secondaire petit apparition" style="margin-top: 1.2rem">
          {europeens} % des organisations obtiennent la note A (fournisseurs européens).
        </p>
      </div>
      <div class="cadre-carte apparition">
        <CarteFrance departements={departements()} titre="Note moyenne par département" />
      </div>
    </section>

    <section class="section" aria-labelledby="titre-recents" style="padding-top: 0">
      <h2 id="titre-recents" class="apparition">Derniers scans</h2>
      <p class="chapeau apparition">
        Chaque fiche détaille les constats, leurs preuves et des alternatives européennes.
      </p>
      <ul class="grille">
        {recents.map((entree) => <li class="apparition"><CarteOrganisation entree={entree} /></li>)}
      </ul>
      <p style="margin-top: 2rem">
        <a class="bouton bouton--secondaire" href="/classements/">Toutes les organisations →</a>
      </p>
    </section>

    <section class="section" aria-labelledby="titre-limites" style="padding-top: 0">
      <h2 id="titre-limites" class="apparition">Ce que mesure (et ne mesure pas) le score</h2>
      <div class="principes">
        <div class="principe apparition">
          <span class="principe__icone" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
          </span>
          <h3>Une analyse passive</h3>
          <p>
            Seules les informations publiques sont consultées : enregistrements DNS, adresses IP,
            quelques pages du site. Aucun formulaire n'est soumis, aucune faille n'est testée.
          </p>
        </div>
        <div class="principe apparition">
          <span class="principe__icone" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path></svg>
          </span>
          <h3>Une empreinte externe</h3>
          <p>
            Le score ne dit rien des logiciels internes ni des contrats. Il indique une
            <strong>dépendance</strong> visible, pas une faute : ce sont des pistes de réflexion.
          </p>
        </div>
        <div class="principe apparition">
          <span class="principe__icone" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="m8 8-5 4 5 4M16 8l5 4-5 4M14 4l-4 16"></path></svg>
          </span>
          <h3>Une méthode ouverte</h3>
          <p>
            Chaque point retiré est justifié par une preuve. La
            <a href="/methodologie/">méthodologie</a> et le code sont publics et versionnés.
          </p>
        </div>
      </div>
    </section>

    <section class="appel apparition" aria-labelledby="titre-appel">
      <EtoilesEurope />
      <h2 id="titre-appel">Votre site n'est pas dans l'observatoire&nbsp;?</h2>
      <p>Demandez son analyse passive : résultat public, réponse en général en moins d'une heure.</p>
      <BoutonAnalyse />
    </section>
  </div>
</Base>
