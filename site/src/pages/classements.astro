---
// Ancienne adresse : fusionnée dans /explorer/ (filtres ?departement=, ?type=, ?texte= et
// ancre conservés). Page de redirection minimale, non indexée.
const cible = "/explorer/";
const ancre = "#organisations";
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Explorer · Bleu Blanc Cloud</title>
    <link rel="canonical" href={cible} />
    <script is:inline define:vars={{ cible, ancre }}>
      location.replace(cible + location.search + (location.hash || ancre));
    </script>
    <meta http-equiv="refresh" content={`0; url=${cible}${ancre}`} />
  </head>
  <body>
    <p>Cette page a déménagé : <a href={`${cible}${ancre}`}>Explorer l'observatoire</a>.</p>
  </body>
</html>
