{
  "name": "bleublanccloud-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "EUPL-1.2",
  "description": "Site statique de l'observatoire Bleu Blanc Cloud",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "types": "node scripts/generer-types.mjs",
    "carte": "node scripts/preparer-carte.mjs",
    "verifier": "astro check && tsc --noEmit -p tsconfig.json",
    "verifier:externe": "node scripts/verifier-requetes.mjs",
    "test": "node --experimental-strip-types --no-warnings --test src/lib/*.test.ts",
    "image-partage": "node scripts/generer-image-partage.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "astro": "7.3.5",
    "d3-geo": "3.1.1",
    "topojson-client": "3.1.0",
    "topojson-server": "3.0.1",
    "topojson-simplify": "3.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/d3-geo": "3.1.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.3",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-server": "3.0.4",
    "@types/topojson-simplify": "3.0.3",
    "@types/topojson-specification": "1.0.5",
    "json-schema-to-typescript": "16.0.0",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3"
  }
}
