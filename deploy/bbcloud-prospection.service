# Prospection badge « Note A » : envoi programmé des mails (classeur privé, jamais publié).
[Unit]
Description=Bleu Blanc Cloud — envoi programmé de la prospection badge « Note A »
Documentation=https://github.com/Berachem/bleu-blanc-cloud/blob/main/deploy/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=bbcloud
Group=bbcloud
WorkingDirectory=/opt/bleu-blanc-cloud
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/bleu-blanc-cloud/deploy/prospection.sh
SyslogIdentifier=bbcloud-prospection
TimeoutStartSec=4h
Nice=10
IOSchedulingClass=idle
# Durcissement
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/bleu-blanc-cloud /home/bbcloud
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
