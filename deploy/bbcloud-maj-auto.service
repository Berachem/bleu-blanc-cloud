# Mise à jour automatique : git fetch → (si nouveau) fusion, dépendances, tests,
# puis régénération et publication du site à partir des données existantes (aucun scan).
[Unit]
Description=Bleu Blanc Cloud — mise à jour automatique du code et du site
Documentation=https://github.com/Berachem/bleu-blanc-cloud/blob/main/deploy/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=bbcloud
Group=bbcloud
WorkingDirectory=/opt/bleu-blanc-cloud
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=ASTRO_TELEMETRY_DISABLED=1
ExecStart=/opt/bleu-blanc-cloud/deploy/maj-auto.sh
SyslogIdentifier=bbcloud-maj-auto
TimeoutStartSec=1h
Nice=10
IOSchedulingClass=idle
# Durcissement
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/bleu-blanc-cloud /home/bbcloud
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
